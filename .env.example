# API keys - copy this file to .env and fill in the values
# (never committed - .env is in .gitignore)

# Mapillary Graph API v4
MAPILLARY_CLIENT_TOKEN=your_mapillary_client_token_here

# PDOK (BAG, OGC API v2)
PDOK_API_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1/free
PDOK_RADIUS=200

# Study area Delft (bbox)
BBOX=4.353,52.006,4.363,52.014